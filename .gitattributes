# Keep LF line endings in web files so the CSP hash of the inline
# theme script (see .htaccess) matches on every machine and server.
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.php  text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
.htaccess text eol=lf
*.webmanifest text eol=lf

*.pdf  binary
*.png  binary
*.webp binary
*.ico  binary
