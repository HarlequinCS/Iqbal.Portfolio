# =============================================================
# Portfolio: Apache configuration for the private server
# Author: Muhammad Saiful Iqbal Abdul Rani
# Needs: mod_rewrite, mod_headers (recommended), PHP 7.4+ for api/contact.php
# =============================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

# -------------------------------------------------------------
# 1. Rewrites: HTTPS, hidden files, hot-link protection
# -------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical address: www.saifuliqbal.io → https://saifuliqbal.io
  RewriteCond %{HTTP_HOST} ^www\.saifuliqbal\.io$ [NC]
  RewriteRule ^ https://saifuliqbal.io%{REQUEST_URI} [L,R=301]

  # Force HTTPS (skipped for local development hosts)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never serve dotfiles/dot-folders (.git, .env, .claude …), except .well-known
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

  # Never serve repository-only files
  RewriteRule ^(README\.md|LICENSE|wip\.css\.map|tools/.*|docs/.*)$ - [R=404,L,NC]

  # SEO: one URL per page. /index.html -> /, /page.html -> /page (permanent).
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  # No work index page: /work and /work/ go to the homepage's work section.
  RewriteRule ^work/?$ /#work [R=301,L,NE]
  # The error page is never a 200 page.
  RewriteRule ^404$ - [R=404,L]
  # Serve clean URLs from the .html files.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Hot-link protection for images: allow empty referrers (direct visits,
  # social previews) and this site's own host, whatever the domain is.
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_HOST}@@%{HTTP_REFERER} !^([^@]+)@@https?://\1(/|$) [NC]
  RewriteCond %{REQUEST_URI} !/images/og-image\.png$ [NC]
  RewriteRule \.(jpe?g|png|gif|webp|svg)$ - [F,NC,L]
</IfModule>

# -------------------------------------------------------------
# 2. Compression
# -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/manifest+json image/svg+xml
</IfModule>

# -------------------------------------------------------------
# 3. Caching
#    Images/fonts rarely change: cache long. CSS and js/main.js links carry ?v=<hash>
#    (tools/build.py), so a change is picked up at once; cache for a day, then revalidate.
# -------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
    # Downloadable, but kept out of search results (they contain a phone number).
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# -------------------------------------------------------------
# 4. Security headers
# -------------------------------------------------------------
<IfModule mod_headers.c>
  # Content Security Policy:
  # - scripts: this site + the one inline theme script (by hash; see docs/DEPLOY.md
  #   if you change that script). JSON-LD blocks are data, not scripts.
  # - styles/fonts: this site only (IBM Plex is self-hosted in /fonts). 'unsafe-inline' styles cover a few style="" attributes.
  # - connect: only this site (the contact form posts to /api/contact.php).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-+1hJWWJuUVnAvkspFViCtOeQxjkrCQv+nU0tX0Q5W3Y='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS: only sent over HTTPS. Add "; includeSubDomains" once every subdomain uses HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# Hide the server version where the host allows it
ServerSignature Off

# -------------------------------------------------------------
# 5. Error pages
# -------------------------------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
